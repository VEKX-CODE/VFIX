@echo off
echo ==============================================================
echo       УСТАНОВКА VFIX USB ДРАЙВЕРА МГНОВЕННОГО ЗАПУСКА
echo ==============================================================
echo.
echo Регистрация фоновой службы VFIX в Планировщике Windows...

set AGENT_PATH=c:\code\gemini\vfix\VFIX_Agent.exe

schtasks /create /f /tn "VFIX_Usb_AutoLaunch" /tr "\"%AGENT_PATH%\"" /sc onlogon /rl highest

echo.
echo [V] Драйвер успешно зарегистрирован!
echo Теперь при включении ПК служба всегда активна в фоне:
echo как только вы вставляете провод от телефона - на весь экран
echo моментально разворачивается черный экран VFIX с логами,
echo а при выдергивании провода - экран сам исчезает!
echo ==============================================================
pause
